# =================================================================
# IBM Guardium Data Protection (GDP) MCP Server Configuration
# =================================================================

# Modo de transporte del servidor MCP: "stdio" (para IDE/Antigravity local) o "streamable-http"
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8003

# Directorio de la caché de descubrimiento de endpoints (opcional; por defecto
# la raíz del proyecto).
# GDP_CACHE_DIR=/ruta/a/cache

# -----------------------------------------------------------------
# 1. Conexión REST API al Appliance (Central Manager o Colector)
# -----------------------------------------------------------------
GDP_HOST=192.168.1.50
GDP_PORT=8443
GDP_USERNAME=admin
GDP_PASSWORD=tu_password_gui
GDP_CLIENT_ID=gdp_aim_client
GDP_CLIENT_SECRET=tu_client_secret_oauth
GDP_VERIFY_SSL=false

# -----------------------------------------------------------------
# 2. Conexión CLI / SSH (Opcional, para la herramienta gdp_guard_cli)
# -----------------------------------------------------------------
GDP_CLI_HOST=192.168.1.50
GDP_CLI_PORT=22
GDP_CLI_USER=cli
GDP_CLI_PASS=tu_password_cli
# Para instancias en AWS/Cloud con autenticación por llave RSA privada:
# GDP_CLI_KEY_FILE=/home/usuario/.ssh/id_rsa_guardium_aws

# Sesión SSH persistente: se reutiliza entre comandos (~0.3 s en vez de ~9 s cada uno).
# Guardium cierra las sesiones CLI inactivas ~4 min, así que la sesión se recicla tras
# GDP_CLI_IDLE_TTL segundos sin uso (por defecto 180, máximo efectivo 210).
# GDP_CLI_PERSISTENT=true
# GDP_CLI_IDLE_TTL=180

# -----------------------------------------------------------------
# 3. Modo Multi-Appliance (Opcional)
# -----------------------------------------------------------------
# Si deseas gestionar varios appliances a la vez, define nombres separados por coma:
# GDP_APPLIANCES=cm01,collector01
# GDP_CM01_HOST=192.168.1.50
# GDP_COLLECTOR01_HOST=192.168.1.51
